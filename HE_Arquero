#include <stdio.h>

int main() {
    int choice;
    float balance = 500.00, amount;

    do {
        printf("\n===== BSIT BANK ATM =====\n");
        printf("1. Balance Inquiry\n");
        printf("2. Deposit\n");
        printf("3. Withdraw\n");
        printf("4. Exit\n");
        printf("Choose an option: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("Current Balance: PHP %.2f\n", balance);
                break;

            case 2:
                printf("Enter deposit amount: PHP ");
                scanf("%f", &amount);

                if (amount > 0) {
                    balance += amount;
                    printf("Deposit successful!\n");
                    printf("Updated Balance: PHP %.2f\n", balance);
                } else {
                    printf("Invalid deposit amount!\n");
                }
                break;

            case 3:
                printf("Enter withdrawal amount: PHP ");
                scanf("%f", &amount);

                if (amount <= 0) {
                    printf("Invalid withdrawal amount!\n");
                } else if (balance - amount < 100.00) {
                    printf("Withdrawal denied! You must maintain at least "
                           "PHP 100.00 in your account.\n");
                } else {
                    balance -= amount;
                    printf("Please collect your money.\n");
                    printf("Remaining Balance: PHP %.2f\n", balance);
                }
                break;

            case 4:
                printf("Thank you for using BSIT Bank ATM!\n");
                break;

            default:
                printf("Invalid option. Please choose from 1 to 4.\n");
        }

    } while (choice != 4);

    return 0;
}
